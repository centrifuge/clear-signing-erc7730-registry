  "display": {
    "formats": {
      "send(address token, uint256 amount, bytes32 receiver, uint256 destinationChainId, address refundAddress)": {
        "intent": "Bridge tokens",
        "interpolatedIntent": "Bridge {amount} to chain {destinationChainId}",
        "fields": [
          {
            "path": "token",
            "label": "Token",
            "format": "addressName",
            "params": {
              "types": [
                "token"
              ]
            },
            "visible": "always"
          },
          {
            "path": "amount",
            "label": "Amount",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "token"
            },
            "visible": "always"
          },
          {
            "path": "receiver",
            "label": "Recipient",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "destinationChainId",
            "label": "Destination chain",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "refundAddress",
            "label": "Refund gas to",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "contract"
              ]
            },
            "visible": "always"
          }
        ]
      }
    }
  }
